{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeusDesigns",
  "version": "0.1.0",
  "identifier": "app.zeusdesigns.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZeusDesigns",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "center": true,
        "backgroundColor": "#141218",
        "additionalBrowserArgs": "--enable-low-end-device-mode --in-process-broker --renderer-process-limit=1 --process-per-site --disable-site-isolation-trials --force-gpu-mem-available-mb=24 --gpu-program-cache-size-kb=256 --gpu-rasterization-msaa-sample-count=0 --num-raster-threads=1 --disable-gpu-shader-disk-cache --disable-2d-canvas-image-chromium --aggressive-cache-discard --disable-webgl --disable-webgl2 --disable-3d-apis --disable-accelerated-2d-canvas --disable-accelerated-video-decode --disable-accelerated-video-encode --disable-notifications --disable-speech-api --disable-file-system --disable-presentation-api --disable-shared-workers --js-flags=--optimize-for-size,--lite-mode,--lazy,--max-semi-space-size=1,--initial-old-space-size=4,--max-old-space-size=48 --enable-features=NetworkServiceInProcess,NetworkServiceInProcess2,StorageServiceInProcess,OptimizeLoadingDataUrls --disable-features=IsolateOrigins,site-per-process,SpareRendererForSitePerProcess,msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,MediaRouter,DialMediaRouteProvider,WinUseBrowserSpellChecker,AudioServiceOutOfProcess,BackForwardCache,Prerender2,InterestFeedContentSuggestions,AutofillServerCommunication,CertificateTransparencyComponentUpdater,CalculateNativeWinOcclusion --disable-extensions --disable-component-update --disable-background-networking --disable-sync --disable-default-apps --no-first-run --no-default-browser-check --no-pings --disk-cache-size=1048576 --media-cache-size=524288"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico", "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
