{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeusDesigns",
  "version": "0.1.0",
  "identifier": "app.zeusdesigns.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZeusDesigns",
        "width": 1480,
        "height": 920,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#141218"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico", "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
